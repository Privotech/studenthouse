{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@naijaplay/shared": ["./packages/shared/src/index.ts"],
      "@naijaplay/shared/*": ["./packages/shared/src/*"],
      "@naijaplay/validation": ["./packages/validation/src/index.ts"],
      "@naijaplay/validation/*": ["./packages/validation/src/*"],
      "@naijaplay/permissions": ["./packages/permissions/src/index.ts"],
      "@naijaplay/permissions/*": ["./packages/permissions/src/*"],
      "@naijaplay/game-engine": ["./packages/game-engine/src/index.ts"],
      "@naijaplay/game-engine/*": ["./packages/game-engine/src/*"],
      "@naijaplay/database": ["./packages/database/src/index.ts"],
      "@naijaplay/database/*": ["./packages/database/src/*"],
      "@naijaplay/ui": ["./packages/ui/src/index.ts"],
      "@naijaplay/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
