# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE (Neon PostgreSQL)
# The app and Prisma use DATABASE_URL; legacy NEON_DATABASE_URL is ignored.
# Set DATABASE_URL to Neon's pooled URL (hostname includes "-pooler").
# Set DIRECT_URL to the direct/unpooled URL for Prisma migrations.
# Copy both from the same project, branch, database, and role after rotating the exposed password.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# AUTHENTICATION (Auth.js / NextAuth)
AUTH_SECRET="GENERATE_A_RANDOM_SECRET"
AUTH_URL="http://localhost:3000"

# CACHE & RATE LIMITING (Upstash / Redis)
REDIS_URL="redis://localhost:6379"

# CLOUDINARY (Authenticated Creative Studio image storage)
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# EMAIL (Resend for Guardian Consent & Transactional Verification)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
EMAIL_FROM="safety@naijaplay.ng"

# PLATFORM CONFIGURATION
NEXT_PUBLIC_DEFAULT_COUNTRY="NG"
NEXT_PUBLIC_APP_ENV="development"
